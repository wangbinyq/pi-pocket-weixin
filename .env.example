# Copy to .env locally; never commit this token.
POCKET_URL=http://127.0.0.1:8080
POCKET_TOKEN=replace-with-your-pocket-owner-token
# Phone-reachable Pocket origin for ALL outbound Pocket links (no login token).
# Unset: explicit unavailable notice, never fall back to the local API URL.
# POCKET_PUBLIC_URL=https://pocket.example.com
# Defaults to ~/.local/share/pi-pocket-weixin
# WEIXIN_DATA_DIR=/absolute/private/data/directory
# /new uses Pocket's default working directory unless specified here.
# POCKET_NEW_CWD=/absolute/project/directory
# Quiet period for merging rapid text (0 disables, max 2000 ms).
# WEIXIN_TEXT_BATCH_DELAY_MS=300
