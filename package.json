  "dependencies": {
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode": "1.5.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
